{
  "schema_version": "1.1.0",
  "pipeline": ["route", "parse", "structure", "generate", "validate", "export", "review"],
  "status_values": ["✅完成", "🔄进行中", "⏸待确认", "⛔阻断", "↩回滚", "⚪未开始"],
  "node_contract_fields": [
    "node_id",
    "status",
    "goal",
    "inputs",
    "truth_sources",
    "derived_outputs",
    "debug_notes",
    "pollution_risks",
    "skill_used",
    "tool_candidates",
    "model_candidates",
    "artifacts",
    "qa_gate",
    "stop_policy",
    "rollback_to"
  ],
  "runtime_contract_fields": [
    "template_id",
    "skill_id",
    "tool_ids",
    "input_mapping",
    "context_mapping",
    "prompt_template",
    "input_schema",
    "output_schema",
    "runtime_config",
    "constraints",
    "fallback",
    "execution_unit",
    "structured_output_schema",
    "model_policy",
    "qa_gates",
    "rollback_policy",
    "artifact_contract"
  ],
  "control_rule": {
    "dispatch_when": "all_dependencies_ready",
    "stop_on_validation_error": true,
    "rollback": {
      "enabled": true,
      "target": "current_or_previous_successful_node",
      "preserve_confirmed_upstream": true,
      "clear_current_and_downstream": true
    },
    "resume": {
      "enabled": true,
      "from": "current_or_previous_successful_node"
    }
  },
  "nodes": [
    {
      "node_id": "route",
      "display_name": "路由",
      "order": 1,
      "skill_id": "sop-route",
      "goal": "Decide simple direct answer vs SOP pipeline and identify objective, input sufficiency, truth sources, constraints, risks, validation, and rollback points.",
      "inputs": ["user_request", "available_files", "available_context"],
      "outputs": ["route_decision", "pipeline_state", "risk_summary"],
      "tool_candidates": ["local_search", "local_read", "user_input"],
      "model_candidates": ["current_codex", "gpt_5_5_thinking"],
      "qa_gate": ["goal_clear", "input_sufficiency_checked", "truth_sources_classified", "sop_need_decided"],
      "stop_policy": "Stop if SOP is required and execution has not already been approved.",
      "rollback_to": "route"
    },
    {
      "node_id": "parse",
      "display_name": "解析",
      "order": 2,
      "skill_id": "sop-parse",
      "goal": "Separate truth sources, derived outputs, debug notes, pollution risks, constraints, and open evidence gaps.",
      "inputs": ["route_decision", "truth_source_candidates", "files_or_messages"],
      "outputs": ["source_map", "evidence_gaps", "pollution_risk_map"],
      "tool_candidates": ["local_read", "local_search", "ocr", "pdf_extract", "web_search"],
      "model_candidates": ["current_codex", "gpt_5_5_thinking", "research"],
      "qa_gate": ["source_map_exists", "derived_not_used_as_truth", "critical_facts_sourced", "pollution_risks_marked"],
      "stop_policy": "Stop only when evidence gaps materially change scope, facts, or feasibility.",
      "rollback_to": "route"
    },
    {
      "node_id": "structure",
      "display_name": "结构化",
      "order": 3,
      "skill_id": "sop-structure",
      "goal": "Turn parsed inputs into schemas, outlines, storylines, page plans, field tables, component contracts, or execution contracts.",
      "inputs": ["source_map", "requirements", "constraints"],
      "outputs": ["structure_contract", "schema", "outline_or_page_plan", "acceptance_criteria"],
      "tool_candidates": ["local_read", "json_validate", "mermaid"],
      "model_candidates": ["current_codex", "gpt_5_5_thinking"],
      "qa_gate": ["structure_maps_to_goal", "required_fields_present", "source_refs_attached", "generation_ready"],
      "stop_policy": "Stop for confirmation after significant schemas, outlines, page plans, visual contracts, or execution contracts.",
      "rollback_to": "parse"
    },
    {
      "node_id": "generate",
      "display_name": "生成",
      "order": 4,
      "skill_id": "sop-generate",
      "goal": "Create artifacts from confirmed structure using registered skills, tools, and model aliases.",
      "inputs": ["confirmed_structure_contract", "source_map", "style_or_format_requirements"],
      "outputs": ["draft_or_artifact", "generation_log", "asset_or_component_usage"],
      "tool_candidates": ["html_editor", "magazine_editor", "pptx", "pdf_generate", "image_generation", "ocr", "transcribe", "tts"],
      "model_candidates": ["current_codex", "gpt_5_5", "gpt_5_5_thinking", "image2", "research"],
      "qa_gate": ["uses_confirmed_structure", "availability_disclosed", "source_refs_preserved", "artifact_created"],
      "stop_policy": "Stop before generation if style, source sufficiency, banned wording, or scope remains unconfirmed.",
      "rollback_to": "structure"
    },
    {
      "node_id": "validate",
      "display_name": "验证",
      "order": 5,
      "skill_id": "sop-validate",
      "goal": "Run QA as a blocking gate across facts, schema, components, rendering, format, source traceability, and user constraints.",
      "inputs": ["artifact", "structure_contract", "source_map", "constraints"],
      "outputs": ["qa_report", "pass_or_block", "rollback_instruction"],
      "tool_candidates": ["local_search", "json_validate", "playwright", "pdf_render", "screenshot", "web_search"],
      "model_candidates": ["current_codex", "gpt_5_5_thinking"],
      "qa_gate": ["facts_checked", "schema_checked", "format_checked", "render_checked_when_needed", "constraints_checked"],
      "stop_policy": "Always stop on blocking QA failure and route back to the failing node.",
      "rollback_to": "generate"
    },
    {
      "node_id": "export",
      "display_name": "导出",
      "order": 6,
      "skill_id": "sop-export",
      "goal": "Package verified artifacts into requested formats and record paths, validation status, and portability notes.",
      "inputs": ["validated_artifact", "qa_report", "delivery_requirements"],
      "outputs": ["final_artifact_paths", "delivery_manifest", "portability_notes"],
      "tool_candidates": ["html_save", "pdf_export", "pptx", "zip_package", "local_read"],
      "model_candidates": ["current_codex"],
      "qa_gate": ["qa_passed_before_export", "format_matches_request", "paths_recorded", "no_debug_controls_in_delivery"],
      "stop_policy": "Stop after export with concise delivery paths and local QA status.",
      "rollback_to": "validate"
    },
    {
      "node_id": "review",
      "display_name": "复盘",
      "order": 7,
      "skill_id": "sop-review",
      "goal": "Summarize pipeline states, artifacts, QA results, failures, rollbacks, reusable selections, and follow-up improvements.",
      "inputs": ["pipeline_state", "delivery_manifest", "qa_report", "user_feedback"],
      "outputs": ["review_summary", "reuse_candidates", "next_actions"],
      "tool_candidates": ["local_read", "local_search"],
      "model_candidates": ["current_codex", "gpt_5_5_thinking"],
      "qa_gate": ["validation_not_overstated", "risks_disclosed", "next_actions_concrete"],
      "stop_policy": "End with current state and next action.",
      "rollback_to": "route"
    }
  ]
}
