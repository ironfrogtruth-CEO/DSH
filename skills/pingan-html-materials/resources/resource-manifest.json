        "00_总索引/关系索引.csv",
        "00_总索引/知识库文件清单.csv",
        "00_总索引/检索与引用规范.md"
      ]
    },
    {
      "name": "portable_presale_subset",
      "mode": "portable_fallback",
      "root_candidates": [
        "resources/knowledge/presale"
      ],
      "required_indexes": [
        "INDEX.md",
        "01_售前材料内容结构.md",
        "05_产品场景与客户方案映射.md"
      ]
    }
