+/**
+ * Owner-only DingTalk control card.
+ *
+ * The profile's published template is the official dynamic-form contract:
+ * public `title`, private `form_fields`, `form_status`, `button_text` and
+ * `err_msg`.  Only TEXT and SELECT fields are rendered; CHECKBOX fields are
+ * intentionally absent because the published template warns about them.
+ * Business state remains in Commands (ctx.sessionQuery, ctx.llm and Bindings).
+ */
+import { createHmac, randomBytes, timingSafeEqual } from 'node:crypto';
+import { cardTarget } from './targets.js';
+
+export const CONSOLE_CARD_TTL_MS = 2 * 60 * 60 * 1000;
+const MAX_CARDS = 100;
+const MAX_FIELDS = 8;
+const MAX_OPTIONS = 10;
+const MAX_PARAMS = 32;
+const SELECT_NAMES = new Set(['view', 'sessionSlot', 'modelSlot', 'effortSlot', 'presetSlot', 'taskAction']);
+const SELECT_ACTIONS = new Set(['', 'select', 'view', 'sessionSlot', 'modelSlot', 'effortSlot', 'presetSlot', 'taskAction']);
+const VIEWS = ['首页', '会话', '模型', '推理等级', '产物', '任务'];
+const ACTIONS = ['不执行动作', '停止当前任务', '新会话'];
+const ACTION_VALUES = ['none', 'stop', 'new'];
+const SLOT_PREFIX = { view: 'v', sessionSlot: 's', modelSlot: 'm', effortSlot: 'e', presetSlot: 'p', taskAction: 'a' };
+
+function text(value, max = 240) {
+    return String(value ?? '').replace(/[\r\n]+/g, ' ').replace(/`/g, "'").trim().slice(0, max);
+}
+
+function detailText(value, max = 8_000) {
+    return String(value ?? '').replace(/\r\n/g, '\n').replace(/\r/g, '\n').replace(/[ \t]+/g, ' ').replace(/`/g, "'").trim().slice(0, max);
+}
+
+function paramsObject(value) {
+    return value && typeof value === 'object' && !Array.isArray(value) ? value : undefined;
+}
+
+function stableValue(value, depth = 0) {
+    if (depth > 5) return '[depth]';
+    if (value === null || typeof value === 'string' || typeof value === 'number' || typeof value === 'boolean') return value;
+    if (Array.isArray(value)) return value.slice(0, 40).map((item) => stableValue(item, depth + 1));
+    if (value && typeof value === 'object') {
+        const output = {};
+        for (const key of Object.keys(value).sort().slice(0, MAX_PARAMS)) output[key] = stableValue(value[key], depth + 1);
+        return output;
+    }
+    return String(value);
+}
+
+function fingerprint(params, actionId) {
+    return `${actionId}\u0000${JSON.stringify(stableValue(paramsObject(params) ?? {}))}`;
+}
+
+function validParams(params, allowed) {
+    if (!params || typeof params !== 'object' || Array.isArray(params)) return false;
+    const keys = Object.keys(params);
+    if (keys.length > MAX_PARAMS) return false;
