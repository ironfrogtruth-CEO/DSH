+    bySession = new Map();
+    pendingRecords = new Map();
+    completedUsageSessions = new Set();
+    constructor(options = {}) {
+        this.service = options.service;
+        this.subscriberId = options.subscriberId;
+        this.accountId = options.accountId;
+        this.log = typeof options.log === 'function' ? options.log : () => {};
+    }
+    leaseId(value) {
+        return String(value?.reservationId ?? value?.leaseId ?? value?.id ?? value?.lease?.reservationId ?? value?.lease?.leaseId ?? value?.lease?.id ?? '').trim();
+    }
+    denied(value) {
+        return value === false || value?.ok === false || value?.allowed === false || value?.granted === false || value?.reserved === false || value?.status === 'denied' || value?.status === 'blocked';
+    }
+    async begin(input = {}) {
+        const requestId = String(input.requestId ?? `${this.accountId}:${input.scopeKey ?? input.conversationId ?? ''}:${Date.now()}`);
+        let value;
+        if (typeof this.service?.beginQuotaLease === 'function') {
+            try {
+                value = await this.service.beginQuotaLease(this.subscriberId, {
+                    requestId,
+                    sessionId: input.sessionId,
+                    conversationId: input.conversationId,
+                    operation: input.operation,
+                    metadata: { accountId: this.accountId, scopeKey: input.scopeKey },
+                });
+            }
+            catch {
+                try {
+                    value = await this.service.beginQuotaLease({ subscriberId: this.subscriberId, accountId: this.accountId, ...input, requestId });
+                }
+                catch {
+                    value = false;
+                }
+            }
+        }
+        else {
+            // A future service may expose the lease through quotaGate.  Only a
+            // response carrying a lease id is accepted by this adapter.
+            for (const name of ['quotaGate', 'gate']) {
+                if (typeof this.service?.[name] !== 'function') continue;
+                try {
+                    value = await this.service[name]({ subscriberId: this.subscriberId, accountId: this.accountId, ...input, requestId });
+                }
+                catch {
+                    value = false;
+                }
+                if (value !== undefined) break;
+            }
+        }
+        const reservationId = this.leaseId(value);
+        if (this.denied(value) || !reservationId)
+            return false;
+        this.leases.set(requestId, { requestId, reservationId, sessionId: input.sessionId ? String(input.sessionId) : '', scopeKey: input.scopeKey ? String(input.scopeKey) : '', lastTotal: 0, usageSeen: false });
