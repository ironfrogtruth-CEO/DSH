+/**
+ * Owner-only DingTalk control card.
+ *
+ * The profile's published template is the official dynamic-form contract:
+ * public `title`, private `form_fields`, `form_status`, `button_text` and
+ * `err_msg`.  Only TEXT and SELECT fields are rendered; CHECKBOX fields are
+ * intentionally absent because the published template warns about them.
+ * Business state remains in Commands (ctx.sessionQuery, ctx.llm and Bindings).
+ */
+import { createHmac, randomBytes, timingSafeEqual } from 'node:crypto';
+import { cardTarget } from './targets.js';
+
+export const CONSOLE_CARD_TTL_MS = 2 * 60 * 60 * 1000;
+const MAX_CARDS = 100;
+const MAX_FIELDS = 8;
+const MAX_OPTIONS = 10;
+const MAX_PARAMS = 32;
+const SELECT_NAMES = new Set(['view', 'sessionSlot', 'modelSlot', 'effortSlot', 'presetSlot', 'taskAction']);
+const SELECT_ACTIONS = new Set(['', 'select', 'view', 'sessionSlot', 'modelSlot', 'effortSlot', 'presetSlot', 'taskAction']);
+const VIEWS = ['首页', '会话', '模型', '推理等级', '产物', '任务'];
+const ACTIONS = ['不执行动作', '停止当前任务', '新会话'];
+const ACTION_VALUES = ['none', 'stop', 'new'];
+const SLOT_PREFIX = { view: 'v', sessionSlot: 's', modelSlot: 'm', effortSlot: 'e', presetSlot: 'p', taskAction: 'a' };
+
+function text(value, max = 240) {
+    return String(value ?? '').replace(/[\r\n]+/g, ' ').replace(/`/g, "'").trim().slice(0, max);
+}
+
+function detailText(value, max = 8_000) {
+    return String(value ?? '').replace(/\r\n/g, '\n').replace(/\r/g, '\n').replace(/[ \t]+/g, ' ').replace(/`/g, "'").trim().slice(0, max);
+}
+
+function paramsObject(value) {
+    return value && typeof value === 'object' && !Array.isArray(value) ? value : undefined;
+}
+
+function stableValue(value, depth = 0) {
+    if (depth > 5) return '[depth]';
+    if (value === null || typeof value === 'string' || typeof value === 'number' || typeof value === 'boolean') return value;
+    if (Array.isArray(value)) return value.slice(0, 40).map((item) => stableValue(item, depth + 1));
+    if (value && typeof value === 'object') {
+        const output = {};
+        for (const key of Object.keys(value).sort().slice(0, MAX_PARAMS)) output[key] = stableValue(value[key], depth + 1);
+        return output;
+    }
+    return String(value);
+}
+
+function fingerprint(params, actionId) {
+    return `${actionId}\u0000${JSON.stringify(stableValue(paramsObject(params) ?? {}))}`;
+}
+
+function validParams(params, allowed) {
+    if (!params || typeof params !== 'object' || Array.isArray(params)) return false;
+    const keys = Object.keys(params);
+    if (keys.length > MAX_PARAMS) return false;
+    for (const key of keys) {
+        if (!allowed.has(key)) return false;
+        const value = params[key];
+        if (typeof value === 'string' && value.length <= 2_000) continue;
+        if (typeof value === 'number' && Number.isSafeInteger(value)) continue;
+        if (typeof value === 'boolean') continue;
+        if (value && typeof value === 'object' && !Array.isArray(value)) continue;
+        if (Array.isArray(value) && key === 'submit_form_fields' && value.length <= MAX_FIELDS) continue;
+        return false;
+    }
+    return true;
+}
+
+function versionOf(params) {
+    const value = paramsObject(params)?.version;
+    if (typeof value === 'number' && Number.isSafeInteger(value)) return value;
+    if (typeof value === 'string' && /^\d{1,9}$/.test(value)) return Number(value);
+    return undefined;
+}
+
+function selectIndex(value) {
+    const object = paramsObject(value);
+    return object && Number.isSafeInteger(object.index) ? object.index : undefined;
+}
+
+function textField(name, label, value) {
+    return { type: 'TEXT', name, label: text(label, 80), default_string: text(value, 1_200) };
+}
+
+function selectField(name, label, options, selected, prefix, version) {
+    const bounded = options.slice(0, MAX_OPTIONS).map((item, index) => ({
+        value: `v${version}:${prefix}${index + 1}`,
+        text: { zh_CN: text(item, 120) },
+    }));
+    return {
+        type: 'SELECT',
+        name,
+        label: text(label, 80),
+        placeholder: bounded.length ? `请选择${text(label, 40)}` : '暂无可选项',
+        ...(bounded.length && Number.isSafeInteger(selected) && selected >= 0 && selected < bounded.length ? { default_number: selected } : {}),
+        options: bounded,
+    };
+}
+
+function outputPayload(fields, status, errorText, buttonText = '') {
+    return {
+        title: '大神控制台',
+        form_fields: JSON.stringify(fields.slice(0, MAX_FIELDS)),
+        form_status: status,
+        button_text: buttonText || (status === 'disabled' ? '已应用' : '应用设置 / 执行动作'),
+        err_msg: text(errorText, 600),
+    };
+}
+
+function visibleFieldNames(viewIndex) {
+    if (viewIndex === 1) return new Set(['status', 'view', 'sessionSlot']);
+    if (viewIndex === 2) return new Set(['status', 'view', 'modelSlot']);
+    if (viewIndex === 3) return new Set(['status', 'view', 'modelSlot', 'effortSlot']);
+    if (viewIndex === 4) return new Set(['status', 'view', 'artifacts']);
+    if (viewIndex === 5) return new Set(['status', 'view', 'presetSlot', 'taskAction']);
+    return new Set(['status', 'view']);
+}
+
+function refreshCachedFields(record, fields) {
+    const refreshed = fields.filter((field) => field?.name !== 'notice').map((field) => {
+        if (field?.type !== 'SELECT' || !SLOT_PREFIX[field.name]) return field;
+        const selected = record.selections[field.name];
+        const next = {
+            ...field,
+            options: (field.options ?? []).map((option, index) => ({
+                ...option,
+                value: `v${record.version}:${SLOT_PREFIX[field.name]}${index + 1}`,
+            })),
+        };
+        if (Number.isSafeInteger(selected) && selected >= 0 && selected < next.options.length) next.default_number = selected;
+        else delete next.default_number;
+        return next;
+    });
+    return refreshed;
+}
+
+export class ConsoleCards {
+    deps;
+    secret = randomBytes(32);
+    cards = new Map();
+    constructor(deps) {
+        this.deps = deps;
+    }
+    signedOutTrackId(userId, conversationId) {
+        const nonce = randomBytes(8).toString('hex');
+        const message = `${nonce}\u0000${userId}\u0000${conversationId}`;
+        const signature = createHmac('sha256', this.secret).update(message).digest('hex').slice(0, 24);
+        return `dshc1_${nonce}_${signature}`;
+    }
+    verifyOutTrackId(outTrackId, record) {
+        const match = /^dshc1_([0-9a-f]{16})_([0-9a-f]{24})$/.exec(outTrackId);
+        if (!match) return false;
+        const message = `${match[1]}\u0000${record.userId}\u0000${record.conversationId}`;
+        const expected = createHmac('sha256', this.secret).update(message).digest('hex').slice(0, 24);
+        return timingSafeEqual(Buffer.from(match[2]), Buffer.from(expected));
+    }
+    clear(outTrackId) {
+        const record = this.cards.get(outTrackId);
+        if (record) clearTimeout(record.expiryTimer);
+        this.cards.delete(outTrackId);
+    }
+    prune() {
+        const now = Date.now();
+        for (const [id, record] of this.cards) if (record.expiresAt <= now) this.clear(id);
+        while (this.cards.size >= MAX_CARDS) this.clear(this.cards.keys().next().value);
+    }
+    async formState(record) {
+        const commands = this.deps.commands;
+        const status = commands.statusSnapshot(record.scopeKey);
+        const statusText = [
+            `会话：${text(status.bound || '尚未建立')}`,
+            `模型：${text(status.model)}`,
+            `工作模式：${text(status.preset || 'CyberMarcus')}`,
+            `排队：${status.queueDepth} 条在途`,
+            ...status.connector.map((line) => text(line)),
+        ].join('\n');
+        const viewIndex = record.selections.view;
+        const fields = [
+            textField('status', '当前状态', statusText),
+            selectField('view', '查看内容', VIEWS, viewIndex, 'v', record.version),
+        ];
+        let sessions = [];
+        let models = [];
+        let efforts = [];
+        let artifacts = [];
+        let presets = [];
+        if (viewIndex === 1) {
+            sessions = (await commands.sessionRowsFor(record.scopeKey)).slice(0, MAX_OPTIONS);
+            fields.push(selectField('sessionSlot', '会话', sessions.map((item) => text(item.title)), record.selections.sessionSlot, 's', record.version));
+        }
+        else if (viewIndex === 2) {
+            models = (await commands.modelRowsFor()).slice(0, MAX_OPTIONS);
+            fields.push(selectField('modelSlot', '模型', models.map((item) => `${text(item.provider)}/${text(item.model)}`), record.selections.modelSlot, 'm', record.version));
+        }
+        else if (viewIndex === 3) {
+            models = (await commands.modelRowsFor()).slice(0, MAX_OPTIONS);
+            const selectedModel = Number.isSafeInteger(record.selections.modelSlot)
+                ? models[record.selections.modelSlot]
+                : undefined;
+            const route = commands.deps?.modelOverrides?.get?.(record.scopeKey) ?? commands.deps?.defaultModel?.();
+            efforts = selectedModel?.efforts?.length
+                ? selectedModel.efforts.map((item) => text(item))
+                : route?.provider && route?.model
+                    ? (await commands.deps.llm?.resolveModelInfo?.(route.provider, route.model))?.reasoning?.efforts?.map((item) => text(item?.id)).filter(Boolean) ?? []
+                    : [];
+            fields.push(selectField('modelSlot', '模型', models.map((item) => `${text(item.provider)}/${text(item.model)}`), record.selections.modelSlot, 'm', record.version));
+            fields.push(selectField('effortSlot', '推理等级', efforts, record.selections.effortSlot, 'e', record.version));
+        }
+        else if (viewIndex === 4) {
+            try {
+                artifacts = (await commands.artifactRowsFor(record.scopeKey))?.slice(0, MAX_OPTIONS) ?? [];
+            }
+            catch {
+                artifacts = [];
+            }
+            const artifactText = artifacts.length
+                ? artifacts.map((item) => `${text(item.relativeName, 180)} · ${text(item.type)} · ${text(item.size)} · ${text(item.time)}`).join('\n')
+                : '暂无近期产物';
+            fields.push(textField('artifacts', '近期产物', artifactText));
+        }
+        else if (viewIndex === 5) {
+            presets = (await commands.presetRowsFor(record.scopeKey)).slice(0, MAX_OPTIONS);
+            if (!Number.isSafeInteger(record.selections.presetSlot)) {
+                const preferred = commands.presetPreferenceFor(record.scopeKey);
+                const preferredIndex = presets.findIndex((item) => item.id === preferred);
+                record.selections.presetSlot = preferredIndex >= 0 ? preferredIndex : (presets.length ? 0 : undefined);
+            }
+            fields.push(selectField('presetSlot', '工作模式', presets.map((item) => text(item.name || item.id)), record.selections.presetSlot, 'p', record.version));
+            fields.push(selectField('taskAction', '动作', ACTIONS, record.selections.taskAction, 'a', record.version));
+        }
+        return { fields, sessions, models, efforts, artifacts, presets };
+    }
+    async payload(record, status = 'normal', errorText = '') {
+        const state = await this.formState(record);
+        record.viewState = state;
+        return { payload: outputPayload(state.fields, status, errorText, record.successButtonText || (record.notice ? '✓ 设置已应用' : '')), state };
+    }
+    payloadFromCached(record, state, status = 'normal', errorText = '') {
+        const nextState = { ...state, fields: refreshCachedFields(record, state.fields) };
+        record.viewState = nextState;
+        return { payload: outputPayload(nextState.fields, status, errorText, record.successButtonText || (record.notice ? '✓ 设置已应用' : '')), state: nextState };
+    }
+    async open(msg, scopeKey) {
+        if (!this.deps.interactionCards || !this.deps.isOwner?.(msg)) return false;
+        this.prune();
+        const outTrackId = this.signedOutTrackId(msg.senderStaffId, msg.conversationId);
+        const record = {
+            outTrackId,
+            userId: msg.senderStaffId,
+            conversationId: msg.conversationId,
+            sessionWebhook: msg.sessionWebhook,
+            scopeKey,
+            version: 1,
+            expiresAt: Date.now() + CONSOLE_CARD_TTL_MS,
+            selections: { view: 0, sessionSlot: undefined, modelSlot: undefined, effortSlot: undefined, presetSlot: undefined, taskAction: 0 },
+            notice: '',
+            successButtonText: '',
+            responses: new Map(),
+            expiryTimer: undefined,
+        };
+        record.expiryTimer = setTimeout(() => {
+            if (this.cards.get(outTrackId) === record) this.cards.delete(outTrackId);
+        }, CONSOLE_CARD_TTL_MS);
+        record.expiryTimer.unref?.();
+        this.cards.set(outTrackId, record);
+        try {
+            const built = await this.payload(record);
+            const privateData = {
+                form_fields: built.payload.form_fields,
+                form_status: built.payload.form_status,
+                button_text: built.payload.button_text,
+                err_msg: built.payload.err_msg,
+            };
+            const delivered = await this.deps.interactionCards.create({
+                outTrackId,
+                kind: 'console',
+                target: cardTarget(msg),
+                cardData: { title: built.payload.title, ...privateData },
+                title: built.payload.title,
+                detail: '',
+                approveLabel: built.payload.button_text,
+                rejectLabel: built.payload.button_text,
+            });
+            if (!delivered) {
+                this.clear(outTrackId);
+                return false;
+            }
+            return true;
+        }
+        catch (error) {
+            this.deps.log(`console card create failed: ${error instanceof Error ? error.message : error}`);
+            this.clear(outTrackId);
+            return false;
+        }
+    }
+    cardUpdate(record, payload) {
+        const privateData = {
+            form_fields: payload.form_fields,
+            form_status: payload.form_status,
+            button_text: payload.button_text,
+            err_msg: payload.err_msg,
+        };
+        return {
+            outTrackId: record.outTrackId,
+            version: String(record.version),
+            cardData: { cardParamMap: { title: payload.title } },
+            userPrivateData: { cardParamMap: privateData },
+            cardUpdateOptions: { updateCardDataByKey: true, updatePrivateDataByKey: true },
+        };
+    }
+    async fallback(record, content) {
+        try {
+            if (record.sessionWebhook) await this.deps.outbound.sendMarkdown(record.sessionWebhook, this.deps.markdownTitle, content);
+        }
+        catch (error) {
+            this.deps.log(`console Markdown fallback failed: ${error instanceof Error ? error.message : error}`);
+        }
+    }
+    async handleSelect(record, params) {
+        const name = paramString(params, 'name', 40);
+        const type = paramString(params, 'type', 40);
+        if (!SELECT_NAMES.has(name) || type !== 'SELECT') return undefined;
+        const selected = paramsObject(params)?.[name];
+        const index = selectIndex(selected);
+        if (!Number.isSafeInteger(index) || index < 0) return undefined;
+        if (name === 'view') {
+            if (index >= VIEWS.length || paramsObject(selected)?.value !== `v${record.version}:v${index + 1}`) return undefined;
+            record.notice = '';
+            record.successButtonText = '';
+            record.selections.view = index;
+            record.version += 1;
+            const next = await this.payload(record);
+            return this.cardUpdate(record, next.payload);
+        }
+        const built = record.viewState;
+        if (!built || record.selections.view === undefined) return undefined;
+        const field = built.fields.find((item) => item.name === name);
+        if (!field || field.type !== 'SELECT' || index >= field.options.length) return undefined;
+        if (typeof paramsObject(selected)?.value !== 'string' || paramsObject(selected).value !== field.options[index].value) return undefined;
+        record.notice = '';
+        record.successButtonText = '';
+        record.selections[name] = index;
+        if (name === 'modelSlot') record.selections.effortSlot = undefined;
+        record.version += 1;
+        const next = name === 'modelSlot' && record.selections.view === 3
+            ? await this.payload(record)
+            : this.payloadFromCached(record, built);
+        return this.cardUpdate(record, next.payload);
+    }
+    async handleSubmit(record, params) {
+        const submitted = submittedFields(params);
+        if (!submitted) return undefined;
+        const state = await this.formState(record);
+        const fields = new Map(state.fields.map((field) => [field.name, field]));
+        const indices = {};
+        const viewField = submitted.get('view');
+        if (!viewField || !fields.has('view')) return undefined;
+        if (viewField.default_number === undefined || viewField.default_number < 0 || viewField.default_number >= fields.get('view').options.length) return undefined;
+        const visible = visibleFieldNames(viewField.default_number);
+        for (const name of SELECT_NAMES) {
+            const field = submitted.get(name);
+            if (!visible.has(name)) continue;
+            if (!field) return undefined;
+            const current = fields.get(name);
+            if (!current || current.type !== 'SELECT') return undefined;
+            if (field.default_number === undefined) continue;
+            if (field.default_number < 0 || field.default_number >= current.options.length) return undefined;
+            const submittedOption = Array.isArray(field.options) ? field.options[field.default_number] : undefined;
+            const currentOption = current.options[field.default_number];
+            if (!submittedOption || typeof submittedOption.value !== 'string' || submittedOption.value !== currentOption.value) return undefined;
+            indices[name] = field.default_number;
+        }
+        const targetSession = state.sessions[indices.sessionSlot];
+        const targetModel = state.models[indices.modelSlot];
+        const targetEffort = state.efforts[indices.effortSlot];
+        const targetPreset = state.presets[indices.presetSlot];
+        const task = ACTION_VALUES[indices.taskAction];
+        if (indices.sessionSlot !== undefined && !targetSession) return undefined;
+        if (indices.modelSlot !== undefined && !targetModel) return undefined;
+        if (indices.effortSlot !== undefined && !targetEffort) return undefined;
+        if (indices.presetSlot !== undefined && !targetPreset) return undefined;
+        if (targetModel) {
+            const result = await this.deps.commands.useModel(record.scopeKey, targetModel.provider, targetModel.model, targetEffort);
+            if (!result.ok) return { error: result.error || '模型校验失败，未执行切换。' };
+        }
+        else if (targetEffort) {
+            const result = await this.deps.commands.useEffort(record.scopeKey, targetEffort);
+            if (!result.ok) return { error: result.error || '推理等级校验失败，未执行切换。' };
+        }
+        if (targetSession) {
+            const result = await this.deps.commands.useSession(record.scopeKey, targetSession.id);
+            if (!result.ok) return { error: '会话映射已变化，请刷新后重试。' };
+        }
+        if (task === 'stop') this.deps.commands.stopSession(record.scopeKey);
+        if (task === 'new') {
+            if (!targetPreset) return { error: '请选择工作模式后再新建会话。' };
+            const prepared = await this.deps.commands.prepareNewSession(record.scopeKey, targetPreset.id);
+            if (!prepared.ok) return { error: prepared.error || '新会话准备失败。' };
+            record.successButtonText = `✓ 新会话已准备：${text(prepared.row?.name || targetPreset.name || targetPreset.id, 50)}`;
+        }
+        else {
+            record.successButtonText = '✓ 设置已应用';
+        }
+        record.selections = { view: viewField.default_number, sessionSlot: indices.sessionSlot, modelSlot: indices.modelSlot, effortSlot: indices.effortSlot, presetSlot: indices.presetSlot, taskAction: 0 };
+        record.notice = '设置已应用。';
+        record.version += 1;
+        const next = this.payloadFromCached(record, state, 'normal');
+        return this.cardUpdate(record, next.payload);
+    }
+    async handleCardCallback(callback) {
+        const record = this.cards.get(callback?.outTrackId);
+        if (!record) return { handled: false, response: {} };
+        if (record.expiresAt <= Date.now() || !this.verifyOutTrackId(callback.outTrackId, record)) {
+            this.clear(record.outTrackId);
+            return { handled: true, response: {} };
+        }
+        if (callback.userId !== record.userId || !this.deps.isOwnerId?.(callback.userId)) return { handled: true, response: {} };
+        const params = paramsObject(callback.params);
+        if (!params || !Array.isArray(callback.actionIds) || callback.actionIds.length > 1) return { handled: true, response: {} };
+        const actionId = String(callback.actionIds[0] ?? '');
+        const hasSubmit = Object.prototype.hasOwnProperty.call(params, 'submit_form_fields');
+        const selectionName = typeof params.name === 'string' ? params.name : '';
+        if (hasSubmit) {
+            // Published dynamic-form templates use a generated component action
+            // id.  The signed card record, bound owner and strict submitted-field
+            // schema are the authorization boundary; accept only a bounded,
+            // printable template id instead of guessing its generated value.
+            if (actionId && !/^[A-Za-z0-9_.:-]{1,160}$/.test(actionId)) return { handled: true, response: {} };
+        }
+        else if (!(SELECT_ACTIONS.has(actionId) || SELECT_NAMES.has(selectionName))) {
+            return { handled: true, response: {} };
+        }
+        const allowedParams = new Set(['version']);
+        if (hasSubmit) allowedParams.add('submit_form_fields');
+        else {
+            allowedParams.add('name');
+            allowedParams.add('type');
+            if (selectionName) allowedParams.add(selectionName);
+        }
+        if (!validParams(params, allowedParams)) return { handled: true, response: {} };
+        if (Object.prototype.hasOwnProperty.call(params, 'version') && versionOf(params) === undefined) return { handled: true, response: {} };
+        const key = fingerprint(params, hasSubmit ? 'submit' : `select:${selectionName}`);
+        const prior = record.responses.get(key);
+        if (prior) return { handled: true, response: prior };
+        const version = versionOf(params);
+        if (version !== undefined && version !== record.version) {
+            const current = await this.payload(record);
+            return { handled: true, response: this.cardUpdate(record, current.payload) };
+        }
+        try {
+            const result = hasSubmit ? await this.handleSubmit(record, params) : await this.handleSelect(record, params);
