@@ -0,0 +1,520 @@
+/**
+ * Runtime account supervisor for the DingTalk channel.
+ *
+ * The published connector starts every configured account in one Promise.all.
+ * That is fine for a static, single-owner deployment but it makes subscriber
+ * accounts impossible to add/remove without restarting the Host and lets one
+ * bad credential reject the whole startup.  AccountManager deliberately keeps
+ * the account lifecycle outside the account implementation: each account owns
+ * its Stream, state directory, queue and bindings, while this class only
+ * reconciles immutable account specs and disposes them with a bound.
+ */
+import { createHash } from 'node:crypto';
+import { beginRegistration as onboardBeginRegistration, waitForCredentials as onboardWaitForCredentials } from './onboard.js';
+
+export const SUBSCRIBER_BRAND = Object.freeze({
+    name: '大神',
+    description: '大神｜Visible Workflow. Reliable Intelligence.',
+});
+
+/** Convert service-owned account ids into safe, bounded state-directory keys. */
+export function runtimeAccountStateId(value) {
+    const raw = String(value ?? '').trim().toLowerCase();
+    if (/^[a-z][a-z0-9-]{0,31}$/u.test(raw))
+        return raw;
+    const digest = createHash('sha256').update(raw || 'account', 'utf8').digest('hex').slice(0, 16);
+    return `acct-${digest}`;
+}
+
+const DEFAULT_DISPOSE_TIMEOUT_MS = 5_000;
+const DEFAULT_POLL_INTERVAL_MS = 30_000;
+
+function isObject(value) {
+    return value !== null && typeof value === 'object';
+}
+
+function accountProfile(spec) {
+    const value = String(spec?.profile ?? spec?.accessProfile ?? spec?.role ?? '').trim().toLowerCase();
+    return value === 'subscriber' || value === '订阅者' || Boolean(spec?.subscriberId || spec?.subscriptionId)
+        ? 'subscriber'
+        : 'system_owner';
+}
+
+function accountId(spec, index = 0) {
+    const value = String(spec?.id ?? spec?.accountId ?? spec?.robotId ?? spec?.subscriberId ?? '').trim();
+    if (value)
+        return value;
+    return accountProfile(spec) === 'subscriber' ? `subscriber-${index + 1}` : 'default';
+}
+
+function asArray(value) {
+    if (Array.isArray(value))
+        return value;
+    if (isObject(value)) {
+        for (const key of ['accounts', 'robots', 'robotAccounts', 'items', 'data']) {
+            if (Array.isArray(value[key]))
+                return value[key];
+        }
+    }
+    return [];
+}
+
+function normalizeSpec(raw, index = 0) {
+    if (!isObject(raw))
+        return undefined;
+    const profile = accountProfile(raw);
+    const id = accountId(raw, index);
+    const credentialRef = String(raw.credentialRef ?? raw.credentialsRef ?? '').trim();
+    const credentialPrefix = credentialRef.endsWith('_CLIENT_ID') || credentialRef.endsWith('_CLIENT_SECRET')
+        ? credentialRef.replace(/_(?:CLIENT_ID|CLIENT_SECRET)$/u, '')
+        : credentialRef;
+    return {
+        ...raw,
+        id,
+        ...(raw.clientId || raw.credentials?.clientId || raw.robot?.clientId
+            ? { clientId: String(raw.clientId ?? raw.credentials?.clientId ?? raw.robot?.clientId).trim() }
+            : {}),
+        ...(raw.clientSecret || raw.credentials?.clientSecret || raw.robot?.clientSecret
+            ? { clientSecret: String(raw.clientSecret ?? raw.credentials?.clientSecret ?? raw.robot?.clientSecret).trim() }
+            : {}),
+        enabled: raw.enabled !== false,
+        profile,
+        ...(profile === 'subscriber'
+            ? {
+                subscriberId: String(raw.subscriberId ?? raw.subscriptionId ?? raw.userId ?? id).trim(),
+                ...(raw.clientIdRef || credentialPrefix
+                    ? { clientIdRef: String(raw.clientIdRef ?? `${credentialPrefix}_CLIENT_ID`).trim() }
+                    : {}),
+                ...(raw.clientSecretRef || credentialPrefix
+                    ? { clientSecretRef: String(raw.clientSecretRef ?? `${credentialPrefix}_CLIENT_SECRET`).trim() }
+                    : {}),
+                // A subscriber must never accidentally inherit an owner file or
+                // the static account's sender policy.
+                senderAccess: 'subscriber',
+                groupAccess: 'none',
+            }
+            : {}),
+    };
+}
+
+function publicSpec(spec) {
+    if (!spec)
+        return undefined;
+    const { clientSecret, secret, token, ...safe } = spec;
+    return safe;
+}
+
+function specFingerprint(spec) {
+    // Include all lifecycle-affecting public fields.  Secret material itself is
+    // never logged/returned, but its digest must trigger a restart after a
+    // credential rotation.
+    const safe = publicSpec(spec);
+    return JSON.stringify({
+        ...safe,
+        clientSecretSha256: spec?.clientSecret
+            ? createHash('sha256').update(String(spec.clientSecret), 'utf8').digest('hex')
+            : '',
+    }, Object.keys(safe).sort().concat('clientSecretSha256'));
+}
+
+function bounded(promise, timeoutMs, fallback) {
+    const ms = Number.isFinite(Number(timeoutMs)) && Number(timeoutMs) > 0
+        ? Math.max(1, Math.floor(Number(timeoutMs)))
+        : DEFAULT_DISPOSE_TIMEOUT_MS;
+    return Promise.race([
+        Promise.resolve(promise),
+        new Promise((resolve) => {
+            const timer = setTimeout(() => resolve(fallback), ms);
+            timer.unref?.();
+        }),
+    ]);
+}
+
+async function callList(service) {
+    if (!service)
+        return [];
+    for (const method of ['listActiveRobotSpecs', 'listActiveRobotAccounts', 'listRobotAccounts', 'getActiveRobotSpecs']) {
+        if (typeof service[method] !== 'function')
+            continue;
+        try {
+            const rows = asArray(await service[method]());
+            return method === 'listRobotAccounts'
+                ? rows.map((item) => ({ ...item, profile: 'subscriber' }))
+                : rows;
+        }
+        catch {
+            return [];
+        }
+    }
+    return [];
+}
+
+/**
+ * Owns independently stoppable DingTalk accounts.  `startAccount` must return
+ * either a disposer function or `{ dispose() }`; failures are isolated to that
+ * account and never escape the reconciliation loop.
+ */
+export class AccountManager {
+    opts;
+    running = new Map();
+    pendingRegistrations = new Map();
+    started = false;
+    disposed = false;
+    reloadTail = Promise.resolve();
+    unsubscribe = undefined;
+    pollTimer = undefined;
+    constructor(opts = {}) {
+        this.opts = opts;
+        this.log = typeof opts.log === 'function' ? opts.log : () => {};
+        this.staticSpecs = (Array.isArray(opts.staticSpecs) ? opts.staticSpecs : Array.isArray(opts.staticAccounts) ? opts.staticAccounts : Array.isArray(opts.accounts) ? opts.accounts : [])
+            .map(normalizeSpec)
+            .filter(Boolean);
+        this.subscriptionService = opts.subscriptionService;
+        this.subscriptionServiceResolver = typeof opts.subscriptionServiceResolver === 'function' ? opts.subscriptionServiceResolver : undefined;
+        this.disposeTimeoutMs = opts.disposeTimeoutMs ?? DEFAULT_DISPOSE_TIMEOUT_MS;
+        this.pollIntervalMs = opts.pollIntervalMs ?? DEFAULT_POLL_INTERVAL_MS;
+    }
+    log;
+    staticSpecs;
+    subscriptionService;
+    subscriptionServiceResolver;
+    disposeTimeoutMs;
+    pollIntervalMs;
+    currentSubscriptionService() {
+        try {
+            return this.subscriptionServiceResolver?.() ?? this.subscriptionService;
+        }
+        catch {
+            return this.subscriptionService;
+        }
+    }
+    /** Start static accounts and any active subscriber robot specs. */
+    async start() {
+        if (this.started)
+            return this;
+        this.started = true;
+        await this.reload();
+        const service = this.currentSubscriptionService();
+        if (typeof service?.onRobotAccountsChanged === 'function') {
+            try {
+                const unsubscribe = service.onRobotAccountsChanged(() => this.reload());
+                if (typeof unsubscribe === 'function')
+                    this.unsubscribe = unsubscribe;
+            }
+            catch (error) {
+                this.log(`subscriber account event registration failed (${error instanceof Error ? error.message : 'unknown error'})`);
+            }
+        }
+        // Keep a low-frequency reconciliation even when event subscription is
+        // available. It closes startup races where the service is registered
+        // after the connector's initial read and no account-change event fires.
+        if (this.pollIntervalMs > 0) {
+            this.pollTimer = setInterval(() => void this.reload(), this.pollIntervalMs);
+            this.pollTimer.unref?.();
+        }
+        return this;
+    }
+    /** Reconcile static owner specs with current active subscriber specs. */
+    async reload() {
+        this.reloadTail = this.reloadTail
+            .catch(() => undefined)
+            .then(() => this.reconcile());
+        return this.reloadTail;
+    }
+    async activeSpecs() {
+        const dynamic = (await callList(this.currentSubscriptionService()))
+            .map((item, index) => normalizeSpec(item, index))
+            .filter(Boolean)
+            .filter((item) => item.profile === 'subscriber' && (item.status === undefined || item.status === 'active'));
+        const result = [];
+        const ids = new Set();
+        for (const spec of [...this.staticSpecs, ...dynamic]) {
+            if (!spec.enabled)
+                continue;
+            if (ids.has(spec.id)) {
+                this.log(`robot ${spec.id}: duplicate accountId rejected`);
+                continue;
+            }
+            ids.add(spec.id);
+            result.push(spec);
+        }
+        return result;
+    }
+    async resolveSpecs(specs) {
+        const hydrated = [];
+        for (const spec of specs) {
+            if (spec.clientId && spec.clientSecret) {
+                hydrated.push(spec);
+                continue;
+            }
+            const service = this.currentSubscriptionService();
+            let credentials;
+            for (const method of ['resolveRobotCredentials', 'getRobotCredentials', 'credentialsForRobot']) {
+                if (typeof service?.[method] !== 'function') continue;
+                try { credentials = await service[method](spec); } catch { credentials = undefined; }
+                if (credentials) break;
+            }
+            hydrated.push(credentials?.clientId && credentials?.clientSecret
+                ? { ...spec, clientId: credentials.clientId, clientSecret: credentials.clientSecret }
+                : spec);
+        }
+        if (typeof this.opts.resolveRuntimeAccounts === 'function') {
+            try {
+                const result = await this.opts.resolveRuntimeAccounts(hydrated);
+                return Array.isArray(result?.accounts) ? result.accounts : [];
+            }
+            catch (error) {
+                this.log(`robot credential resolution failed (${error instanceof Error ? error.message : 'unknown error'})`);
+                return [];
+            }
+        }
+        const resolved = [];
+        for (const spec of hydrated) {
+            if (spec.clientId && spec.clientSecret) {
+                resolved.push(spec);
+                continue;
+            }
+            // No usable credential material was supplied by the configured
+            // credential store or the subscription service.
+        }
+        return resolved;
+    }
+    async reconcile() {
+        if (this.disposed)
+            return;
+        const specs = await this.activeSpecs();
+        const resolved = await this.resolveSpecs(specs);
+        const desired = new Map();
+        const clientIds = new Set();
+        for (const raw of resolved) {
+            const spec = normalizeSpec(raw);
+            if (!spec)
+                continue;
+            if (desired.has(spec.id)) {
+                this.log(`robot ${spec.id}: duplicate accountId rejected`);
+                continue;
+            }
+            const clientId = String(spec.clientId ?? '').trim();
+            if (!clientId) {
+                this.log(`robot ${spec.id}: missing credentials — skipped`);
+                continue;
+            }
+            if (clientIds.has(clientId)) {
+                this.log(`robot ${spec.id}: clientId already used by another robot — skipped`);
+                continue;
+            }
+            clientIds.add(clientId);
+            desired.set(spec.id, spec);
+        }
+        for (const [id, current] of [...this.running.entries()]) {
+            const wanted = desired.get(id);
+            if (!wanted || current.fingerprint !== specFingerprint(wanted))
+                await this.stop(id);
+        }
+        const starts = [];
+        for (const spec of desired.values()) {
+            if (this.running.has(spec.id))
+                continue;
+            starts.push(this.startOne(spec));
+        }
+        await Promise.allSettled(starts);
+    }
+    async startOne(spec) {
+        if (this.disposed || this.running.has(spec.id))
+            return;
+        if (spec.profile === 'subscriber') {
+            const brand = spec.brand;
+            const brandShapeOk = !brand || (brand.name === SUBSCRIBER_BRAND.name && brand.description === SUBSCRIBER_BRAND.description);
+            const brandVerified = spec.brandVerified === true
+                || spec.brandStatus === 'verified'
+                || spec.brandGate === 'passed'
+                || spec.brandCheck?.ok === true
+                || spec.brand?.verified === true;
+            if (!brandShapeOk || !brandVerified) {
+                this.log(`robot ${spec.id}: brand-pending — subscriber account not started`);
+                return;
+            }
+        }
+        try {
+            const handle = await this.opts.startAccount(spec);
+            if (!handle)
+                return;
+            const dispose = typeof handle === 'function' ? handle : handle.dispose;
+            this.running.set(spec.id, {
+                id: spec.id,
+                spec,
+                fingerprint: specFingerprint(spec),
+                handle,
+                dispose: typeof dispose === 'function' ? dispose : async () => {},
+            });
+            this.log(`robot ${spec.id}: account started (${spec.profile})`);
+        }
+        catch (error) {
+            this.log(`robot ${spec.id}: failed to start (${error instanceof Error ? error.message : 'unknown error'})`);
+        }
+    }
+    async stop(id) {
+        const current = this.running.get(id);
+        if (!current)
+            return false;
+        this.running.delete(id);
+        try {
+            await bounded(current.dispose(), this.disposeTimeoutMs, undefined);
+        }
+        catch (error) {
+            this.log(`robot ${id}: dispose failed (${error instanceof Error ? error.message : 'unknown error'})`);
+        }
+        this.log(`robot ${id}: account stopped`);
+        return true;
+    }
+    /** Stop one subscriber without touching other accounts. */
+    async stopSubscriber(accountId) {
+        const current = this.running.get(String(accountId));
+        if (!current || current.spec.profile !== 'subscriber')
+            return false;
+        return this.stop(String(accountId));
+    }
+    async startSubscriberAccount(spec) {
+        const normalized = normalizeSpec(spec);
+        if (!normalized || normalized.profile !== 'subscriber')
+            return false;
+        await this.startOne(normalized);
+        return this.running.has(normalized.id);
+    }
+    async stopSubscriberAccount(accountId) {
+        return this.stopSubscriber(accountId);
+    }
+    /** Force a single account to be re-read and restarted on the next reload. */
+    async reloadAccount(accountId) {
+        await this.stop(String(accountId));
+        await this.reload();
+    }
+    async reloadSubscriberAccount(accountId) {
+        return this.reloadAccount(accountId);
+    }
+    list() {
+        return [...this.running.values()].map((item) => ({ id: item.id, profile: item.spec.profile, subscriberId: item.spec.subscriberId }));
+    }
+    /** Bounded, idempotent teardown for Host disposal and tests. */
+    async dispose() {
+        if (this.disposed)
+            return;
+        this.disposed = true;
+        if (this.pollTimer)
+            clearInterval(this.pollTimer);
+        this.pollTimer = undefined;
+        try {
+            this.unsubscribe?.();
+        }
+        catch {
+            // Event subscription cleanup is best effort.
+        }
+        this.unsubscribe = undefined;
+        await Promise.allSettled([...this.running.keys()].map((id) => this.stop(id)));
+    }
+    /** Start the official scan-to-create flow for a future subscriber robot. */
+    async beginRegistration(options = {}) {
+        const begin = await (this.opts.beginRegistration ?? onboardBeginRegistration)();
+        const registrationId = String(options.registrationId ?? `${Date.now()}-${Math.random().toString(36).slice(2, 10)}`);
+        const record = {
+            ...begin,
+            registrationId,
+            ...(options.subscriberId ? { subscriberId: String(options.subscriberId).trim() } : {}),
+            ...(options.accountId ? { accountId: String(options.accountId).trim() } : {}),
+            brand: SUBSCRIBER_BRAND,
+            createdAt: Date.now(),
+        };
+        this.pendingRegistrations.set(registrationId, record);
+        return this.registrationStatus({ registrationId });
+    }
+    registrationStatus(input = {}) {
+        const registrationId = String(input.registrationId ?? input.id ?? '').trim();
+        const record = this.pendingRegistrations.get(registrationId);
+        if (!record)
+            return { registrationId, status: 'not-found', brandStatus: 'brand-pending' };
+        // Device codes are polling credentials and must remain inside the
+        // connector; the native panel only needs the QR URI and expiry.
+        return {
+            registrationId,
+            status: 'pending',
+            verificationUriComplete: record.verificationUriComplete,
+            expiresInSeconds: record.expiresInSeconds,
+            intervalSeconds: record.intervalSeconds,
+            expiresAt: record.expiresAt,
+            brand: SUBSCRIBER_BRAND,
+            brandStatus: 'brand-pending',
+        };
+    }
+    cancelRegistration(input = {}) {
+        const registrationId = String(input.registrationId ?? input.id ?? '').trim();
+        const existed = this.pendingRegistrations.delete(registrationId);
+        return { registrationId, ok: existed, status: existed ? 'cancelled' : 'not-found' };
+    }
+    /**
+     * Wait for the QR result and hand credentials to the subscription service.
+     * Secrets never appear in the returned object or connector messages.  A
+     * service that cannot persist/verify the branded robot leaves it pending.
+     */
+    async waitForCredentials(registration, options = {}) {
+        const key = typeof registration === 'string' ? registration : registration?.registrationId;
+        const begin = this.pendingRegistrations.get(key) ?? (typeof registration === 'object' ? registration : undefined);
+        if (!begin || !key)
+            throw new Error('unknown subscriber registration');
+        // Methods with a defaulted second argument have Function.length === 1.
+        // The subscription service therefore calls this manager with a single
+        // object envelope. Preserve that envelope as persistence context.
+        const context = {
+            ...(typeof registration === 'object' ? registration : {}),
+            ...begin,
+            ...options,
+        };
+        const credentials = await (this.opts.waitForCredentials ?? onboardWaitForCredentials)(begin);
+        const service = this.currentSubscriptionService();
+        let persisted = false;
+        const accountIdValue = String(context.accountId ?? '').trim();
+        const credentialRef = String(context.credentialRef ?? context.credentialsRef ?? (accountIdValue ? `DINGTALK_ACCOUNT_${accountIdValue.toUpperCase().replace(/[^A-Z0-9]+/gu, '_')}` : '')).trim();
+        // Secret material belongs in the host credential service, never in the
+        // subscriber-control SQLite row or an account spec.  The callback is
+        // injected by the native panel/credential bridge and is intentionally
+        // not user-facing.
+        if (typeof this.opts.persistCredentials === 'function' && credentialRef) {
+            try {
+                await this.opts.persistCredentials(credentialRef, credentials);
+                persisted = true;
+            }
+            catch (error) {
+                this.log(`subscriber robot ${key}: credential persistence failed (${error instanceof Error ? error.message : 'unknown error'})`);
+                return { registrationId: key, status: 'brand-pending', persisted: false };
+            }
+        }
+        for (const method of ['registerRobotAccount', 'saveRobotAccountCredentials', 'persistRobotCredentials']) {
+            if (typeof service?.[method] !== 'function')
+                continue;
+            try {
+                const payload = {
+                    ...context,
+                    registrationId: key,
+                    ...(credentialRef ? { credentialRef } : {}),
+                    brand: SUBSCRIBER_BRAND,
+                    brandStatus: 'brand-pending',
+                };
+                if (method === 'registerRobotAccount' && !credentialRef)
+                    continue;
+                if (method !== 'registerRobotAccount') {
+                    payload.clientId = credentials.clientId;
+                    payload.clientSecret = credentials.clientSecret;
+                }
+                await service[method](payload);
+                persisted = true;
+                break;
+            }
+            catch (error) {
+                this.log(`subscriber robot ${key}: credential persistence failed (${error instanceof Error ? error.message : 'unknown error'})`);
+                return { registrationId: key, status: 'brand-pending', persisted: false };
+            }
+        }
+        this.pendingRegistrations.delete(key);
+        await this.reload();
+        return { registrationId: key, status: 'brand-pending', persisted };
+    }
+}
