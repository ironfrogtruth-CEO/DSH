{
  "schemaVersion": 1,
  "baselineVersion": "0.1.1-rc.2",
  "candidateVersion": null,
  "installStrategy": {
    "stagingRequired": true,
    "allowInPlaceOverwrite": false,
    "switchOnlyAfterAllGatesPass": true,
    "offlineRollbackArtifactRequired": true
  },
  "uiContract": {
    "manifest": "output/deepseek-harness-evolution/ui-integrity/ui-baseline.sha256.json",
    "baselineScreenshot": "output/deepseek-harness-evolution/ui-integrity/current/home-1440x1000.png",
    "allowAutomaticRebaseline": false,
    "protectedPatterns": [
      "apps/*.swift",
      "extensions/**/client.js",
      "custom-ui-patches/**/*.{js,css,tsx,jsx}"
    ],
    "requiredFlows": [
      "home-load",
      "session-switch",
      "composer-text-send",
      "composer-image-route",
      "composer-image-glm-first-fallback",
      "settings-open",
      "existing-tool-card-render",
      "subagent-parallel-start",
      "subagent-parent-child-follow-up",
      "subagent-status-stream-and-open",
      "header-utilities-responsive",
      "dingtalk-status-panel-read-only",
      "dingtalk-profile-safe-defaults",
      "context-injection-hidden-think-visible"
    ]
  },
  "capabilityContract": {
    "requiredProfiles": [
      "profiles/web",
      "profiles/headless",
      "profiles/web-intelligence"
    ],
    "requiredExtensions": [
      "extensions/dsh-intelligence",
      "extensions/dsh-compaction-v2",
      "extensions/dsh-memory",
      "extensions/dsh-cross-session",
      "extensions/dsh-code-intelligence",
      "extensions/dsh-frontend-qa",
      "extensions/dsh-evals",
      "extensions/dsh-tool-policy",
      "extensions/dsh-goal-first-state-machine",
      "extensions/dsh-local-route-policy",
      "extensions/dsh-git",
      "extensions/dsh-knowledge-manager",
      "extensions/dsh-dingtalk-status",
      "extensions/dsh-shrimp-run-status",
      "extensions/shrimp-shell",
      "custom-ui-patches/dsh-client-ui-conversation",
      "custom-ui-patches/dsh-client-ui-agent-preset",
      "custom-ui-patches/dsh-client-ui-workspace"
    ],
    "requiredBehaviors": [
      "append-only-session-events",
      "deepseek-text-model-vision-bridge",
      "structured-continuation-capsule",
      "compaction-memory-candidate",
      "memory-candidate-review",
      "cross-session-project-isolation",
      "taskgraph-evidence-gates",
      "goal-first-session-state-machine",
      "goal-first-output-contract-gate",
      "three-provinces-six-ministries-governance",
      "v4-pro-planner-v4-flash-continuable-executor",
      "continuable-parent-child-message-channel",
      "marvel-dynamic-subagent-naming",
      "durable-subagent-status-stream",
      "ungrouped-sidebar-projection-hidden-data-preserved",
      "context-injection-hidden-think-tool-visible",
      "single-send-durable-image",
      "zhipu-glm-first-local-gemma-fallback",
      "heartbeat-serialized-persistence",
      "heartbeat-explicit-catch-up-window",
      "heartbeat-shrimp-dependency-preflight",
      "host-watchdog-single-listener",
      "host-watchdog-app-recovery",
      "explicit-quit-service-sentinel",
      "daily-local-git-commit-no-push",
      "knowledge-base-manager-ui",
      "knowledge-base-crud-allowlist",
      "knowledge-base-model-read-only",
      "dingtalk-stream-owner-only-ingress",
      "dingtalk-stream-no-group-default",
      "dingtalk-ai-card-fail-soft",
      "dingtalk-read-only-status-projection",
      "shrimp-run-status-durable-session-rail",
      "shrimp-run-status-summary-status-polling",
      "shrimp-run-status-terminal-dismiss-persisted",
      "code-index-candidate-labels",
      "ui-read-only-qa"
    ]
  },
  "gates": [
    {
      "id": "runtime-contract",
      "command": "node scripts/verify-host-architecture.mjs --format json"
    },
    {
      "id": "ui-integrity",
      "command": "node scripts/verify-ui-integrity.mjs check --manifest output/deepseek-harness-evolution/ui-integrity/ui-baseline.sha256.json --json"
    },
    {
      "id": "intelligence-regression",
      "command": "node scripts/run-intelligence-regression.mjs --output output/deepseek-harness-evolution/validation/intelligence-regression-upgrade.json"
    },
    {
      "id": "headless-loader",
      "command": "node profiles/headless/verify-profile.mjs --smoke"
    },
    {
      "id": "doctor",
      "command": "./scripts/doctor"
    },
    {
      "id": "reliable-preset",
      "command": "node skills/reliable-development/scripts/verify_reliable_preset.mjs"
    },
    {
      "id": "goal-first-state-machine",
      "command": "node --test extensions/dsh-goal-first-state-machine/goal-first-state-machine.test.mjs"
    },
    {
      "id": "upgrade-readiness",
      "command": "node scripts/verify-upgrade-readiness.mjs --mode candidate --staging-root <candidate-root> --json"
    }
  ],
  "dataContract": {
    "canonicalState": [
      "sessions",
      "memories",
      "storages",
      "goal-first-state",
      "$HOME/.dsh-dingtalk",
      "private/service-disabled"
    ],
    "mustRemainAppendOnly": [
      "session event logs",
      "compaction source events",
      "memory provenance events",
      "goal-first state events"
    ],
    "derivedIndexesMustBeRebuildable": true,
    "migrationOnCopyFirst": true,
    "rollbackVerificationRequired": true
  },
  "rollback": {
    "targetVersion": "0.1.1-rc.2",
    "preserveFailedCandidateForDiagnosis": true,
    "deleteOrRewriteCanonicalData": false
  }
}
