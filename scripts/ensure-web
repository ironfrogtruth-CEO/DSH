#!/bin/bash
# ensure-web — 确保 dsh web 服务在运行(不打开浏览器)
# 已在运行 → 直接返回(绝不杀现有实例);未运行 → 后台拉起
set -u
PORT="${DSH_PORT:-3080}"
export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
INSTALL_DIR="$HOME/.dsh/install"
INSTALL_NODE_MODULES="$INSTALL_DIR/node_modules"
DSH_BIN="$INSTALL_NODE_MODULES/@deepseek-ai/dsh/lib/bin.js"
LOG="$HOME/.dsh/web.log"
STATE="$HOME/.dsh/.web-load-signature"
GOAL_FIRST_PREFLIGHT="$HOME/.dsh/extensions/dsh-goal-first-state-machine/goal-first-state-machine.test.mjs"
PRIVATE="$HOME/.dsh/private"
LOCK_DIR="$PRIVATE/ensure-web.lock"
PROFILE_DIR="$HOME/.dsh/profiles/web"
PROFILE_PACKAGE="$PROFILE_DIR/package.json"
PROFILE_NODE_MODULES="$PROFILE_DIR/node_modules"
PNPM_BIN="${DSH_PNPM_BIN:-/usr/local/bin/pnpm}"
NPM_BIN="${DSH_NPM_BIN:-/usr/local/bin/npm}"
mkdir -p "$HOME/.dsh" "$PRIVATE"

# mkdir is atomic on macOS. This closes the app/watchdog race where two
# callers both observe an empty port and spawn two Hosts. A dead owner is
# recoverable; a live owner makes this invocation a no-op and the caller's
# health poll will observe the same Host.
acquire_lock() {
  local attempt=0 owner=""
  while [ "$attempt" -lt 3 ]; do
    if mkdir "$LOCK_DIR" 2>/dev/null; then
      printf '%s\n' "$$" >"$LOCK_DIR/pid"
      LOCK_HELD=1
      trap release_lock EXIT
      return 0
    fi
    owner=$(/bin/cat "$LOCK_DIR/pid" 2>/dev/null || true)
    if [ "$owner" != "$$" ] && [[ "$owner" =~ ^[0-9]+$ ]] && kill -0 "$owner" 2>/dev/null; then
      return 1
    fi
    # Stale lock from a crashed launcher. Remove only this exact lock path.
    rm -f "$LOCK_DIR/pid"
    rmdir "$LOCK_DIR" 2>/dev/null || true
    attempt=$((attempt + 1))
  done
  return 1
}

release_lock() {
  if [ "${LOCK_HELD:-0}" = "1" ]; then
    rm -f "$LOCK_DIR/pid"
    rmdir "$LOCK_DIR" 2>/dev/null || true
    LOCK_HELD=0
    trap - EXIT
  fi
}

# The profile manifest can name a local bundle while node_modules still holds
# an older/missing link (the WebView then opens blank because Host boot exits
# before binding 3080). Validate every declared link: dependency before boot;
# repair only from the existing lock/store and never contact the network.
check_profile_local_links() {
  [ -f "$PROFILE_PACKAGE" ] || return 0
  /usr/local/bin/node - "$PROFILE_PACKAGE" "$PROFILE_NODE_MODULES" <<'NODE'
const fs = require('node:fs')
const path = require('node:path')

const packagePath = process.argv[2]
const nodeModules = process.argv[3]
let manifest
try {
  manifest = JSON.parse(fs.readFileSync(packagePath, 'utf8'))
} catch (error) {
  console.error(`PROFILE_PACKAGE_INVALID\t${packagePath}\t${error.message}`)
  process.exit(3)
}

let sourceMissing = false
let linkMissing = false
for (const [name, specifier] of Object.entries(manifest.dependencies || {})) {
  if (typeof specifier !== 'string' || !specifier.startsWith('link:')) continue
  const rawSource = specifier.slice('link:'.length)
  const source = path.isAbsolute(rawSource)
    ? path.resolve(rawSource)
    : path.resolve(path.dirname(packagePath), rawSource)
  const entry = path.join(nodeModules, ...name.split('/'))
  if (!fs.existsSync(source)) {
    sourceMissing = true
    console.error(`PROFILE_LOCAL_SOURCE_MISSING\t${name}\t${source}`)
    continue
  }
  try {
    if (!fs.existsSync(entry) || fs.realpathSync(entry) !== fs.realpathSync(source)) {
      linkMissing = true
      console.error(`PROFILE_LOCAL_LINK_MISSING\t${name}\t${entry}`)
    }
  } catch {
    linkMissing = true
    console.error(`PROFILE_LOCAL_LINK_MISSING\t${name}\t${entry}`)
  }
}
process.exit(sourceMissing ? 3 : linkMissing ? 2 : 0)
NODE
}

ensure_profile_local_links() {
  check_profile_local_links >>"$LOG" 2>&1
  local status=$?
  [ "$status" -eq 0 ] && return 0
  if [ "$status" -ne 2 ]; then
    echo "$(date '+%F %T') ensure-web: PROFILE_LOCAL_LINKS_MISSING source/package invalid; refusing to start Host" >>"$LOG"
    return 1
  fi
  if [ ! -x "$PNPM_BIN" ]; then
    echo "$(date '+%F %T') ensure-web: PROFILE_LOCAL_LINKS_MISSING and pnpm unavailable; refusing to start Host" >>"$LOG"
    return 1
  fi
  echo "$(date '+%F %T') ensure-web: PROFILE_LOCAL_LINKS_MISSING; repairing from offline frozen lock" >>"$LOG"
  if ! (cd "$PROFILE_DIR" && "$PNPM_BIN" install --offline --frozen-lockfile --ignore-scripts) >>"$LOG" 2>&1; then
    echo "$(date '+%F %T') ensure-web: PROFILE_LOCAL_LINKS_REPAIR_FAILED; refusing to start Host" >>"$LOG"
    return 1
  fi
  if ! check_profile_local_links >>"$LOG" 2>&1; then
    echo "$(date '+%F %T') ensure-web: PROFILE_LOCAL_LINKS_REPAIR_FAILED verification; refusing to start Host" >>"$LOG"
    return 1
  fi
}

# node-addon-require-builtin selects a platform-specific native binding before
# Cordis can create its internal ModuleLoader. A package refresh under a
# different macOS architecture can leave the opposite optional package in
# node_modules, making ModuleLoader.fromInternal() empty and the WebView blank.
# Only a real install that declares the entry package participates; lightweight
# test homes and older migrations keep their existing startup behavior.
check_internal_loader_binding() {
  [ -f "$INSTALL_NODE_MODULES/node-addon-require-builtin/package.json" ] || return 0
  /usr/local/bin/node - "$INSTALL_NODE_MODULES" <<'NODE'
const fs = require('node:fs')
const path = require('node:path')

const nodeModules = process.argv[2]
const entryPackage = path.join(nodeModules, 'node-addon-require-builtin')
const entryManifestPath = path.join(entryPackage, 'package.json')
if (!fs.existsSync(entryManifestPath)) process.exit(0)

let entryManifest
try {
  entryManifest = JSON.parse(fs.readFileSync(entryManifestPath, 'utf8'))
} catch (error) {
  console.error(`DSH_NODE_ADDON_PACKAGE_INVALID\t${entryManifestPath}\t${error.message}`)
  process.exit(3)
}

if (process.platform === 'darwin' && (process.arch === 'arm64' || process.arch === 'x64')) {
  const bindingName = `node-addon-require-builtin-${process.platform}-${process.arch}`
  const bindingManifestPath = path.join(nodeModules, bindingName, 'package.json')
  if (!fs.existsSync(bindingManifestPath)) {
    console.error(`DSH_NODE_ADDON_OPTIONAL_BINDING_MISSING\t${bindingName}\t${bindingManifestPath}\t${process.arch}`)
    process.exit(2)
  }
  try {
    const bindingManifest = JSON.parse(fs.readFileSync(bindingManifestPath, 'utf8'))
    if (bindingManifest.name !== bindingName) {
      console.error(`DSH_NODE_ADDON_OPTIONAL_BINDING_INVALID\t${bindingName}\t${bindingManifestPath}`)
      process.exit(3)
    }
  } catch (error) {
    console.error(`DSH_NODE_ADDON_OPTIONAL_BINDING_INVALID\t${bindingName}\t${error.message}`)
    process.exit(3)
  }
}

try {
  const { createRequire } = require('node:module')
  const requireFromInstall = createRequire(entryManifestPath)
  const api = requireFromInstall('node-addon-require-builtin')
  if (!api || typeof api.requireBuiltin !== 'function') throw new Error('requireBuiltin export is unavailable')
  const loader = api.requireBuiltin('internal/modules/esm/loader')
  if (loader === null || loader === undefined) throw new Error('internal ESM loader is empty')
  const info = typeof api.getBindingInfo === 'function' ? api.getBindingInfo() : undefined
  const binding = info && typeof info === 'object' ? `${info.mode || 'unknown'}/${info.backend || 'unknown'}/${info.abi || 'unknown'}` : 'unknown'
  console.log(`DSH_NODE_ADDON_LOADER_OK\t${process.platform}\t${process.arch}\t${binding}`)
} catch (error) {
  console.error(`DSH_NODE_ADDON_LOADER_FAILED\t${process.platform}\t${process.arch}\t${error.message}`)
  process.exit(3)
}
NODE
}

ensure_internal_loader_binding() {
  [ -f "$INSTALL_NODE_MODULES/node-addon-require-builtin/package.json" ] || return 0
  check_internal_loader_binding >>"$LOG" 2>&1
  local status=$?
  [ "$status" -eq 0 ] && return 0
  if [ "$status" -ne 2 ]; then
    echo "$(date '+%F %T') ensure-web: DSH_NODE_ADDON_LOADER_FAILED; refusing to start Host" >>"$LOG"
    return 1
  fi
  if [ ! -f "$INSTALL_DIR/package-lock.json" ]; then
    echo "$(date '+%F %T') ensure-web: DSH_NODE_ADDON_OPTIONAL_BINDING_REPAIR_BLOCKED package-lock missing; refusing to start Host" >>"$LOG"
    return 1
  fi
  if [ ! -x "$NPM_BIN" ]; then
    echo "$(date '+%F %T') ensure-web: DSH_NODE_ADDON_OPTIONAL_BINDING_MISSING and npm unavailable; refusing to start Host" >>"$LOG"
    return 1
  fi
  echo "$(date '+%F %T') ensure-web: DSH_NODE_ADDON_OPTIONAL_BINDING_MISSING; repairing with npm optional dependencies" >>"$LOG"
  if ! "$NPM_BIN" --prefix "$INSTALL_DIR" install --include=optional --ignore-scripts --no-audit --no-fund >>"$LOG" 2>&1; then
    echo "$(date '+%F %T') ensure-web: DSH_NODE_ADDON_OPTIONAL_BINDING_REPAIR_FAILED; refusing to start Host" >>"$LOG"
    return 1
  fi
  if ! check_internal_loader_binding >>"$LOG" 2>&1; then
    echo "$(date '+%F %T') ensure-web: DSH_NODE_ADDON_LOADER_FAILED after optional binding repair; refusing to start Host" >>"$LOG"
    return 1
  fi
}

if ! acquire_lock; then
  exit 0
fi

if [ ! -f "$DSH_BIN" ]; then
  echo "$(date '+%F %T') ensure-web: install 缺失,请执行 cd ~/.dsh/install && npm install @deepseek-ai/dsh@0.1.1-rc.2 --save-exact" >>"$LOG"
  exit 1
fi
if ! ensure_internal_loader_binding; then
  exit 1
fi
if ! ensure_profile_local_links; then
  exit 1
fi
# 大神是本地模型的用户入口。启动 Host 前先把 Ollama、模型缓存与媒体
# 依赖绑定到虾缸/MODEL；云端 provider 不改，且未加载模型时只保留轻量服务。
if [ -x "$HOME/.dsh/scripts/start-local-model-runtime" ]; then
  if ! "$HOME/.dsh/scripts/start-local-model-runtime" >>"$LOG" 2>&1; then
    echo "$(date '+%F %T') ensure-web: local model runtime failed; refusing to start Host" >>"$LOG"
    exit 1
  fi
fi
# LLM 适配器补丁(历史图片块降级为文字占位,防线程报废);幂等,install 升级后自动重打
/usr/local/bin/node "$HOME/.dsh/scripts/patch-llm-image-downcast.mjs" >>"$LOG" 2>&1 || true
# edit 工具自动观察补丁(先读后写策略自动满足,消除 FS_NOT_OBSERVED);幂等
/usr/local/bin/node "$HOME/.dsh/scripts/patch-fs-edit-auto-observe.mjs" >>"$LOG" 2>&1 || true
# generic subagent route inheritance补丁(严格 rc.2 Gate,幂等)
if ! /usr/local/bin/node "$HOME/.dsh/scripts/patch-subagent-selected-route.mjs" >>"$LOG" 2>&1; then
  echo "$(date '+%F %T') ensure-web: subagent route patch failed; refusing to start Host" >>"$LOG"
  exit 1
fi
# Avengers uses a session-local default-model tier so its V4 Pro parent does
# not overwrite CyberMarcus or the process-wide default. Version/anchor drift
# is a startup failure rather than permission to guess at an installed bundle.
if ! /usr/local/bin/node "$HOME/.dsh/scripts/patch-avengers-model-default.mjs" --apply >>"$LOG" 2>&1; then
  echo "$(date '+%F %T') ensure-web: Avengers model-default patch failed; refusing to start Host" >>"$LOG"
  exit 1
fi
# client-only command action补丁(严格 rc.2 Gate,幂等)
if ! /usr/local/bin/node "$HOME/.dsh/scripts/patch-client-command-actions.mjs" >>"$LOG" 2>&1; then
  echo "$(date '+%F %T') ensure-web: client command actions patch failed; refusing to start Host" >>"$LOG"
  exit 1
fi
# Generic ToolRow must render the Host-presented business title instead of
# exposing wire tool names such as goal_first_state_transition. Minimal test
# homes may omit this optional UI patch; an installed but failing patch blocks.
TOOL_TITLE_PATCH="$HOME/.dsh/scripts/patch-tool-call-presentation-titles.mjs"
if [ -f "$TOOL_TITLE_PATCH" ]; then
  if ! /usr/local/bin/node "$TOOL_TITLE_PATCH" --apply >>"$LOG" 2>&1; then
    echo "$(date '+%F %T') ensure-web: tool presentation title patch failed; refusing to start Host" >>"$LOG"
    exit 1
  fi
fi
# Reapply the reviewed UI bundle snapshots after install/package refreshes.
# This keeps the per-session managed-job entry visible across upgrades.
if ! /usr/local/bin/node "$HOME/.dsh/scripts/replay-custom-ui-patches.mjs" --apply >>"$LOG" 2>&1; then
  echo "$(date '+%F %T') ensure-web: custom UI patch replay failed; refusing to start Host" >>"$LOG"
  exit 1
fi

# 本地 shrimp-shell 是独立 ESM 包，必须拥有自己的声明依赖。依赖目录被
# 清理或首次迁移时补装一次；已存在时不访问网络、不重复安装。
SHRIMP_SHELL_DIR="$HOME/.dsh/extensions/shrimp-shell"
if [ ! -f "$SHRIMP_SHELL_DIR/node_modules/@deepseek-ai/dsh-tools/package.json" ]; then
  if ! /usr/local/bin/npm install --prefix "$SHRIMP_SHELL_DIR" --ignore-scripts --no-audit --no-fund >>"$LOG" 2>&1; then
    echo "$(date '+%F %T') ensure-web: shrimp-shell 依赖安装失败" >>"$LOG"
    exit 1
  fi
fi

# 知识库管理 Host 只注册只读模型工具，也需要和 shrimp-shell 一样拥有
# 独立的 dsh-tools 声明依赖；迁移到新 Mac 后首次启动时自动补齐。
KB_MANAGER_DIR="$HOME/.dsh/extensions/dsh-knowledge-manager"
if [ -d "$KB_MANAGER_DIR" ] && [ ! -f "$KB_MANAGER_DIR/node_modules/@deepseek-ai/dsh-tools/package.json" ]; then
  if ! /usr/local/bin/npm install --prefix "$KB_MANAGER_DIR" --ignore-scripts --no-audit --no-fund >>"$LOG" 2>&1; then
    echo "$(date '+%F %T') ensure-web: knowledge-manager 依赖安装失败" >>"$LOG"
    exit 1
  fi
fi

# iMessage bridge is a local-only bundle. Its only external dependency is the
# already-installed DSH tools contract; keep the package self-contained on a
# migrated Mac without touching Messages or sending anything during startup.
IMESSAGE_BRIDGE_DIR="$HOME/.dsh/extensions/dsh-imessage-bridge"
if [ -d "$IMESSAGE_BRIDGE_DIR" ] && [ ! -f "$IMESSAGE_BRIDGE_DIR/node_modules/@deepseek-ai/dsh-tools/package.json" ]; then
  if ! /usr/local/bin/npm install --prefix "$IMESSAGE_BRIDGE_DIR" --ignore-scripts --no-audit --no-fund >>"$LOG" 2>&1; then
    echo "$(date '+%F %T') ensure-web: iMessage bridge 依赖安装失败" >>"$LOG"
    exit 1
  fi
fi

# 端口已监听不等于代码已加载。插件或适配器内容变化时自动重启一次，
# 避免 App 启动后继续使用旧 Node 进程（本次截图污染复发的直接原因）。
SIGNATURE=$(/usr/bin/shasum -a 256 \
  "$HOME/.dsh/settings.yaml" \
  "$HOME/.dsh/.agent-presets/reliable-development/preset.yml" \
  "$HOME/.dsh/.agent-presets/avengers/preset.yml" \
  "$HOME/.dsh/.agent-presets/avengers/agent.cordis.yml" \
  "$HOME/.dsh/profiles/web/package.json" \
  "$HOME/.dsh/container.manifest.yaml" \
  "$HOME/.dsh/extensions/dsh-goal-first-state-machine/index.js" \
  "$HOME/.dsh/extensions/dsh-goal-first-state-machine/machine.js" \
  "$HOME/.dsh/extensions/dsh-local-route-policy/index.js" \
  "$HOME/.dsh/extensions/dsh-local-route-policy/package.json" \
  "$HOME/.dsh/extensions/dsh-tool-policy/index.js" \
  "$HOME/.dsh/extensions/dsh-knowledge-manager/package.json" \
  "$HOME/.dsh/extensions/dsh-knowledge-manager/index.js" \
  "$HOME/.dsh/extensions/dsh-knowledge-manager/client.js" \
  "$HOME/.dsh/extensions/dsh-knowledge-manager/cordis.patch.yml" \
  "$HOME/.dsh/extensions/dsh-knowledge-manager/index.test.mjs" \
  "$HOME/.dsh/extensions/dsh-imessage-bridge/package.json" \
  "$HOME/.dsh/extensions/dsh-imessage-bridge/index.js" \
  "$HOME/.dsh/extensions/dsh-imessage-bridge/client.js" \
  "$HOME/.dsh/extensions/dsh-imessage-bridge/reader.py" \
  "$HOME/.dsh/extensions/dsh-imessage-bridge/send_message.applescript" \
  "$HOME/.dsh/extensions/dsh-imessage-bridge/probe_messages.applescript" \
  "$HOME/.dsh/extensions/dsh-imessage-bridge/vendor/VENDOR-SHA256.md" \
  "$HOME/.dsh/extensions/dsh-imessage-bridge/cordis.patch.yml" \
  "$HOME/.dsh/extensions/dsh-shrimp-run-status/package.json" \
  "$HOME/.dsh/extensions/dsh-shrimp-run-status/index.js" \
  "$HOME/.dsh/extensions/dsh-shrimp-run-status/client.js" \
  "$HOME/.dsh/extensions/dsh-shrimp-run-status/model.mjs" \
  "$HOME/.dsh/extensions/dsh-shrimp-run-status/cordis.patch.yml" \
  "$HOME/.dsh/extensions/dsh-webbridge/package.json" \
  "$HOME/.dsh/extensions/dsh-webbridge/index.js" \
  "$HOME/.dsh/extensions/dsh-webbridge/cordis.patch.yml" \
  "$HOME/.dsh/extensions/dsh-webbridge/native-host/nm-host.js" \
  "$HOME/.dsh/custom-ui-patches/dsh-client-ui-jobs/client.js.modified" \
  "$HOME/.dsh/custom-ui-patches/dsh-client-ui-conversation/client.js.modified" \
  "$HOME/.dsh/custom-ui-patches/dsh-client-ui-agent-preset/client.js.modified" \
  "$HOME/.dsh/custom-ui-patches/dsh-client-ui-subagent/client.js.rc2-archive.modified" \
  "$HOME/.dsh/custom-ui-patches/dsh-client-ui-workspace/client.js.modified" \
  "$HOME/.dsh/custom-ui-patches/shrimp-shell/index.js.modified" \
  "$HOME/.dsh/custom-ui-patches/shrimp-shell/client.js.modified" \
  "$HOME/.dsh/install/node_modules/@deepseek-ai/dsh-client-ui-subagent/lib/client.js" \
  "$HOME/.dsh/install/node_modules/@deepseek-ai/dsh-client-ui-jobs/lib/client.js" \
  "$HOME/.dsh/install/node_modules/@deepseek-ai/dsh-client-ui-commands/lib/client.js" \
	"$HOME/.dsh/install/node_modules/@deepseek-ai/dsh-client-ui-tool/lib/client.js" \
  "$HOME/.dsh/scripts/ensure-web" \
  "$HOME/.dsh/scripts/host-service-state" \
  "$HOME/.dsh/scripts/patch-subagent-selected-route.mjs" \
  "$HOME/.dsh/scripts/patch-avengers-model-default.mjs" \
  "$HOME/.dsh/scripts/patch-client-command-actions.mjs" \
	"$HOME/.dsh/scripts/patch-tool-call-presentation-titles.mjs" \
  "$HOME/.dsh/scripts/replay-custom-ui-patches.mjs" \
  "$HOME/.dsh/scripts/patch-llm-image-downcast.mjs" \
  "$HOME/.dsh/scripts/patch-fs-edit-auto-observe.mjs" \
  "$HOME/.dsh/scripts/daily-git-commit.mjs" \
  "$HOME/.dsh/extensions/dsh-browser/index.js" \
  "$HOME/.dsh/extensions/dsh-memory/index.js" \
  "$HOME/.dsh/extensions/dsh-git/index.js" \
  "$HOME/.dsh/extensions/dsh-git/client.js" \
  "$HOME/.dsh/extensions/zhipu-media/index.js" \
  "$HOME/.dsh/extensions/zhipu-media/client.js" \
  "$HOME/.dsh/mcp-servers/zhipu-mcp/server.mjs" \
  "$HOME/.dsh/extensions/shrimp-shell/index.js" \
  "$HOME/.dsh/extensions/shrimp-shell/client.js" \
  "$HOME/.dsh/install/node_modules/@deepseek-ai/dsh-client-ui-conversation/lib/client.js" \
  "$HOME/.dsh/install/node_modules/@deepseek-ai/dsh-client-ui-agent-preset/lib/client.js" \
  "$HOME/.dsh/install/node_modules/@deepseek-ai/dsh-host-apiproxy/lib/index.js" \
  "$HOME/.dsh/install/node_modules/@deepseek-ai/dsh-llm-deepseek/lib/index.js" \
  "$HOME/.dsh/install/node_modules/@deepseek-ai/dsh-llm-pi-ai/lib/index.js" \
  "$HOME/.dsh/install/node_modules/@deepseek-ai/dsh-tool-fs/lib/index.js" \
  2>/dev/null | /usr/bin/shasum -a 256 | /usr/bin/awk '{print $1}')
LOADED=""
[ -f "$STATE" ] && LOADED=$(/bin/cat "$STATE" 2>/dev/null || true)
if /usr/sbin/lsof -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
  if [ "${DSH_FORCE_RESTART:-0}" != "1" ] && [ -n "$SIGNATURE" ] && [ "$SIGNATURE" = "$LOADED" ]; then
    exit 0
  fi
  # Validate the changed goal-first tool schema and state contracts before
  # stopping a healthy Host.  This keeps the current 3080 listener alive when
  # a candidate extension cannot be compiled by the deployed DSH runtime.
  if [ -f "$GOAL_FIRST_PREFLIGHT" ]; then
    if ! /usr/local/bin/node --test "$GOAL_FIRST_PREFLIGHT" >>"$LOG" 2>&1; then
      echo "$(date '+%F %T') ensure-web: goal-first preflight failed; keeping current Host" >>"$LOG"
      exit 1
    fi
  fi
  echo "$(date '+%F %T') ensure-web: 检测到插件/适配器已更新，重载 Host" >>"$LOG"
  "$HOME/.dsh/scripts/stop" >>"$LOG" 2>&1
fi
cd "$HOME" || exit 1
PTY_RUNNER="$HOME/.dsh/scripts/run-web-pty.py"
PYTHON_RUNNER="/usr/bin/python3"
if [ "$(uname -s)" = "Darwin" ] && [ -x "/usr/bin/python3" ]; then
  # Command Line Tools' /usr/bin/python3 is a launcher. Resolve the real
  # Python.app binary so the foreground PID remains the long-lived PTY owner;
  # otherwise launchd can see the launcher exit and orphan run-web-pty.py.
  ACTUAL_PYTHON=$(/usr/bin/python3 -c 'import os,sys; print(os.path.join(sys.base_prefix,"Resources","Python.app","Contents","MacOS","Python"))' 2>/dev/null || true)
  if [ -n "$ACTUAL_PYTHON" ] && [ -x "$ACTUAL_PYTHON" ]; then
    PYTHON_RUNNER="$ACTUAL_PYTHON"
  fi
fi
if [ "$(uname -s)" = "Darwin" ] && [ -f "$PTY_RUNNER" ]; then
  # rc.8 hosts stdio MCP children and exits when detached stdin immediately
  # reaches EOF. The private PTY stays open without creating a Terminal window.
  if [ "${DSH_FOREGROUND:-0}" = "1" ]; then
    # Keep this LaunchAgent job in the foreground; launchd otherwise reaps
    # the detached Host as soon as the watchdog exits. Hold the lock only
    # through the bind window, then release it so app/upgrade ensure-web calls
    # can compare signatures and intentionally reload this live Host.
    [ -n "$SIGNATURE" ] && /bin/echo "$SIGNATURE" >"$STATE"
    "$PYTHON_RUNNER" "$PTY_RUNNER" /usr/local/bin/node "$DSH_BIN" web --no-open >>"$LOG" 2>&1 &
    HOST_PID=$!
    bound=0
    for _ in $(seq 1 120); do
      if ! kill -0 "$HOST_PID" 2>/dev/null; then break; fi
      if /usr/sbin/lsof -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then bound=1; break; fi
      sleep 0.25
    done
    release_lock
    if [ "$bound" -ne 1 ] && kill -0 "$HOST_PID" 2>/dev/null; then
      echo "$(date '+%F %T') ensure-web: foreground Host 未在 30 秒内监听 $PORT，终止本次启动" >>"$LOG"
      kill "$HOST_PID" 2>/dev/null || true
    fi
    wait "$HOST_PID"
    exit $?
  fi
  /usr/bin/nohup "$PYTHON_RUNNER" "$PTY_RUNNER" /usr/local/bin/node "$DSH_BIN" web --no-open </dev/null >>"$LOG" 2>&1 &
else
  if [ "${DSH_FOREGROUND:-0}" = "1" ]; then
    [ -n "$SIGNATURE" ] && /bin/echo "$SIGNATURE" >"$STATE"
    /usr/local/bin/node "$DSH_BIN" web --no-open >>"$LOG" 2>&1 &
    HOST_PID=$!
    bound=0
    for _ in $(seq 1 120); do
      if ! kill -0 "$HOST_PID" 2>/dev/null; then break; fi
      if /usr/sbin/lsof -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then bound=1; break; fi
      sleep 0.25
    done
    release_lock
    if [ "$bound" -ne 1 ] && kill -0 "$HOST_PID" 2>/dev/null; then
      echo "$(date '+%F %T') ensure-web: foreground Host 未在 30 秒内监听 $PORT，终止本次启动" >>"$LOG"
      kill "$HOST_PID" 2>/dev/null || true
    fi
    wait "$HOST_PID"
    exit $?
  fi
  /usr/bin/nohup /usr/local/bin/node "$DSH_BIN" web --no-open </dev/null >>"$LOG" 2>&1 &
fi
[ -n "$SIGNATURE" ] && /bin/echo "$SIGNATURE" >"$STATE"
exit 0
